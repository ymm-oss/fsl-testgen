def test_scenario_forbidden_FB_1(adapter):
    'Scenario: forbidden_FB-1'
    if not _adapter_ready(adapter):
        pytest.skip('Adapter not implemented')
    adapter.reset()
    adapter.step('pay', {'o': 0})
    _assert_partial_expected(adapter.observe(), {'order': {'0': 'Paid', '1': 'Cart'}})
    adapter.step('ship', {'o': 0})
    _assert_partial_expected(adapter.observe(), {'order': {'0': 'Shipped', '1': 'Cart'}})
    result = adapter.step('cancel', {'o': 0})
    _assert_rejected(result, 'requires_failed')


RANDOM_WALK_INITIAL = {'order': {'0': 'Cart', '1': 'Cart'}}
RANDOM_WALK = [
    ('pay', {'o': 1}, {'order': {'0': 'Cart', '1': 'Paid'}}),
    ('ship', {'o': 1}, {'order': {'0': 'Cart', '1': 'Shipped'}}),
    ('pay', {'o': 0}, {'order': {'0': 'Paid', '1': 'Shipped'}}),
    ('cancel', {'o': 0}, {'order': {'0': 'Cancelled', '1': 'Shipped'}}),
]


def test_random_walk_conformance(adapter):
    'random-walk conformance (baked oracle trace)'
    if not _adapter_ready(adapter):
        pytest.skip('Adapter not implemented')
    adapter.reset()
    assert adapter.observe() == RANDOM_WALK_INITIAL, 'initial state'
    for index, (action, params, expected) in enumerate(RANDOM_WALK):
        adapter.step(action, params)
        assert adapter.observe() == expected, f'random walk step {index}: {action} {params}'
