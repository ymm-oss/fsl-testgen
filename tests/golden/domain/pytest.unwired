    _assert_partial_expected(adapter.observe(), {'order_status': 'OrderStatus_Approved', 'order_refund_issued': False, 'event_OrderApproved': True, 'event_OrderCancelled': False, 'event_OrderShipped': False})
    adapter.step('order_ship_order', {})
