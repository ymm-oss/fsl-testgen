}

fun assertRejected(result: StepResult?, expectedKind: String?) {
    assertNotNull(result, "forbidden step must return a StepResult")
    assertFalse(result.ok)
    if (expectedKind != null) {
        assertEquals(expectedKind, result.kind)
    }
