// Assert only the fields the spec mentions; recurse into nested (Map/struct)
// shapes. Normalize integral values to Long recursively through List/Map before
// equality, preserving exact list order/length and Float/Double distinctions.
fun normalizeIntegral(value: Any?): Any? = when (value) {
    is Byte -> value.toLong()
    is Short -> value.toLong()
