RANDOM_WALK_INITIAL = {'withdrawn': 0, 'audit.balance': 0, 'audit.log': [], 'bank.cleared': 0, 'bank.pending': 0}
RANDOM_WALK = [
    ('deposit_audited', {'a': 2}, {'withdrawn': 0, 'audit.balance': 2, 'audit.log': [2], 'bank.cleared': 0, 'bank.pending': 2}),
    ('deposit_audited', {'a': 3}, {'withdrawn': 0, 'audit.balance': 5, 'audit.log': [2, 3], 'bank.cleared': 0, 'bank.pending': 5}),
    ('bank.settle', {}, {'withdrawn': 0, 'audit.balance': 5, 'audit.log': [2, 3], 'bank.cleared': 5, 'bank.pending': 0}),
    ('deposit_audited', {'a': 3}, {'withdrawn': 0, 'audit.balance': 8, 'audit.log': [2, 3, 3], 'bank.cleared': 5, 'bank.pending': 3}),
    ('withdraw_audited', {'a': 1}, {'withdrawn': 1, 'audit.balance': 8, 'audit.log': [2, 3, 3], 'bank.cleared': 4, 'bank.pending': 3}),
    ('deposit_audited', {'a': 3}, {'withdrawn': 1, 'audit.balance': 11, 'audit.log': [2, 3, 3, 3], 'bank.cleared': 4, 'bank.pending': 6}),
    ('withdraw_audited', {'a': 3}, {'withdrawn': 4, 'audit.balance': 11, 'audit.log': [2, 3, 3, 3], 'bank.cleared': 1, 'bank.pending': 6}),
    ('withdraw_audited', {'a': 1}, {'withdrawn': 5, 'audit.balance': 11, 'audit.log': [2, 3, 3, 3], 'bank.cleared': 0, 'bank.pending': 6}),
    ('bank.settle', {}, {'withdrawn': 5, 'audit.balance': 11, 'audit.log': [2, 3, 3, 3], 'bank.cleared': 6, 'bank.pending': 0}),
    ('withdraw_audited', {'a': 2}, {'withdrawn': 7, 'audit.balance': 11, 'audit.log': [2, 3, 3, 3], 'bank.cleared': 4, 'bank.pending': 0}),
    ('withdraw_audited', {'a': 3}, {'withdrawn': 10, 'audit.balance': 11, 'audit.log': [2, 3, 3, 3], 'bank.cleared': 1, 'bank.pending': 0}),
    ('withdraw_audited', {'a': 1}, {'withdrawn': 11, 'audit.balance': 11, 'audit.log': [2, 3, 3, 3], 'bank.cleared': 0, 'bank.pending': 0}),
]


def test_random_walk_conformance(adapter):
    'random-walk conformance (baked oracle trace)'
    if not _adapter_ready(adapter):
        pytest.skip('Adapter not implemented')
    adapter.reset()
    assert adapter.observe() == RANDOM_WALK_INITIAL, 'initial state'
    for index, (action, params, expected) in enumerate(RANDOM_WALK):
        adapter.step(action, params)
        assert adapter.observe() == expected, f'random walk step {index}: {action} {params}'
